<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Termux 提供的 RUN_COMMAND 权限，用于从本 App 一键拉起后台服务 -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- 音频/相机：Web UI 朗读与语音相关能力可能申请，按需动态授权 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Android 11+ 包可见性：需要显式声明才能查询 / 拉起 Termux -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          刻意不使用前台服务：真正的服务与定时任务跑在 Termux 里，
          由 Termux 的 wake lock / 电池白名单 / 锁定任务卡片负责保活。
          本壳被系统回收后，重新点开图标即可重连，会话与服务状态都在服务端，不丢失。
          这样也避免常驻通知打扰与 Android 14+ 前台服务类型限制。
        -->
    </application>

</manifest>
