<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Termux 提供的 RUN_COMMAND 权限，用于从本 App 一键拉起后台服务。
         这是 dangerous 权限，App 内会直接弹系统授权框，不需要用户翻设置。 -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- 音频/相机：Web UI 朗读与语音相关能力可能申请，按需动态授权 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 通知：服务状态提示（Android 13+ 需动态申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 后台保活：引导页一键把本 App 加入电池优化白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 兼容 Shizuku v11 以下（v11+ 使用自实现权限，无需此声明） -->
    <uses-permission android:name="moe.shizuku.manager.permission.API" />

    <!-- Android 11+ 包可见性：显式声明才能查询 / 拉起 Termux 与 Shizuku -->
    <queries>
        <package android:name="com.termux" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!-- Shizuku Provider：让 Shizuku 把系统级 binder 送进本 App。
             authorities 用 ${applicationId} 占位，由 AGP 自动替换为真实包名。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          刻意不使用前台服务：真正的服务与定时任务跑在 Termux 里，
          由 Termux 的 wake lock / 电池白名单 / 锁定任务卡片负责保活。
          本壳被系统回收后，重新点开图标即可重连，会话与服务状态都在服务端，不丢失。
        -->
    </application>

</manifest>
